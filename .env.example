# Copia este archivo como .env.local SOLO para probar en tu ordenador.
# En Vercel, estas variables se ponen en: Project → Settings → Environment Variables.

# Obligatoria para el chat con IA. Se crea en https://console.anthropic.com
ANTHROPIC_API_KEY=pon-aqui-tu-clave

# Opcionales
ANTHROPIC_MODEL=claude-haiku-5-5
AI_LIMIT_PER_HOUR=20
AI_GLOBAL_LIMIT_PER_HOUR=200
# Tu dominio, para que solo tu web pueda usar el chat (ej.: https://montaje3d.be)
ALLOWED_ORIGIN=
